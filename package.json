    "verify:packed": "node scripts/verify-packed-artifact.mjs",
    "prepublishOnly": "npm run verify:packed"
  },
  "files": [
    "server.js",
    "channel-delivery.js",
    "classifier-risk.js",
    "delivery-policy.js",
    "identity.js",
    "outbox.js",
    "relay-store.js",
    "surface-truth.js",
    "bin/",
    ".claude-plugin/",
